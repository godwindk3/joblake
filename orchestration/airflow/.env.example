# Copy this file to .env only when you want to override local defaults.
# Base image for the custom joblake-airflow:local image. Run build after changing.
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8080

# This PostgreSQL instance stores Airflow metadata only.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace-with-a-local-password

# Replace these before exposing Airflow beyond localhost.
AIRFLOW_API_SECRET_KEY=replace-with-a-long-random-api-secret
AIRFLOW_JWT_SECRET=replace-with-a-long-random-jwt-secret

# Optional. Generate a Fernet key before storing Airflow connections or variables.
AIRFLOW_FERNET_KEY=

# Docker Desktop reaches the published ports of the existing core stack.
# Credentials and POSTGRES_PORT are read from the root JobLake .env by the CLI.
JOBLAKE_MINIO_ENDPOINT=host.docker.internal:9000
JOBLAKE_POSTGRES_HOST=host.docker.internal
