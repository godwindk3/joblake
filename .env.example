TOPCV_DISCOVERY_PROXY=http://proxy-host:3128
TOPCV_DETAIL_PROXY=http://proxy-host:3128
TOPCV_PROXY_USERNAME=
TOPCV_PROXY_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=joblake
MINIO_SECURE=false

# PostgreSQL for parsed/curated job data. Do not commit the real .env file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=joblake
POSTGRES_USER=joblake
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local curated PostgreSQL and Supabase direct PostgreSQL connection strings.
# Keep actual values only in .env.  Supabase's connection screen provides the
# direct connection URI; include sslmode=require when it is not already there.
LOCAL_DATABASE_URL=postgresql://joblake:replace-with-a-long-random-password@localhost:5432/joblake
SUPABASE_DATABASE_URL=postgresql://postgres:replace-with-your-supabase-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
